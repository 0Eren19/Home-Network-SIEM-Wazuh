# Wazuh Manager Configuration Reference

```xml
<!--
Wazuh Manager Configuration Reference

Project: Home Network SIEM

Purpose:
Centralized collection, analysis, and alerting of security events
generated by the monitored Windows 10 endpoint.
-->

<ossec_config>

  <!-- Wazuh Manager -->
  <global>
    <jsonout_output>yes</jsonout_output>
    <alerts_log>yes</alerts_log>
  </global>

  <!-- Remote Agent Communication -->
  <remote>
    <connection>secure</connection>
    <port>1514</port>
    <protocol>tcp</protocol>
  </remote>

  <!-- File Integrity Monitoring -->
  <syscheck>
    <disabled>no</disabled>
    <frequency>43200</frequency>
  </syscheck>

</ossec_config>
```
